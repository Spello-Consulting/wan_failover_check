<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd USER agent that runs WAN Failover Check continuously, the macOS
  equivalent of sydneyapp/wan-failover-check.service.

  Install:
    cp deploy/com.elseyworld.wan_failover_check.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.elseyworld.wan_failover_check.plist
  Test now:
    launchctl kickstart -k gui/$(id -u)/com.elseyworld.wan_failover_check
  Stop / uninstall:
    launchctl bootout gui/$(id -u)/com.elseyworld.wan_failover_check

  No 1Password token here: scripts/launch.sh loads
  ~/.config/op/service-account-token itself.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.elseyworld.wan_failover_check</string>

    <!-- Apple-signed /bin/bash for a stable TCC identity. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nick/scripts/wan_failover_check/scripts/launch.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nick/scripts/wan_failover_check</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart only on a non-zero exit (crash); a graceful shutdown exits 0.
         Mirrors Restart=on-failure / RestartSec=10 in the systemd unit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/nick/scripts/wan_failover_check/logs/user_agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nick/scripts/wan_failover_check/logs/user_agent.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nick</string>
        <key>PATH</key>
        <string>/Users/nick/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
